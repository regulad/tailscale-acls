// regulad's tailnet policy. Applied to the tailnet by
// .github/workflows/tailscale.yml on every push to master.
//
// Access model: whitelist. Nothing is reachable unless a grant below allows
// it. Grants are allow-only and unioned (there is no deny and no ordering),
// so restricting access means narrowing or removing the grant that gives it.
{
    "tagOwners": {
        // Generic always-on machines that may host services or reach other
        // services over the tailnet.
        "tag:server":     ["autogroup:admin"],
        // Separate testing tag, left as-is. Its auto-approver (see
        // "autoApprovers") covers every subnet route.
        "tag:autorouter": ["autogroup:admin"],
        // Peer relays: nodes allowed to advertise themselves as a relay that
        // helps other peers establish connections.
        "tag:relay":      ["autogroup:admin"],
        // Exit nodes, auto-approved under "autoApprovers".
        "tag:autoexit":   ["autogroup:admin"],
        // GitHub Actions runners that publish kodi-plugins; may reach only
        // the publish target (and the DNS resolvers).
        "tag:ci-kodi":    ["autogroup:admin"],
        // IoT devices: restricted, single-purpose devices. They may reach only
        // the services they exist for, plus what every node gets (DNS, exit
        // nodes, the web entry point).
        "tag:iot":        ["autogroup:admin"],
        // Tagged nodes that may publish services to the internet with Funnel
        // (see "nodeAttrs"; admins' devices may without it). It grants no
        // network access: give a node it alongside the tag that does (e.g.
        // tag:server).
        "tag:funnel":     ["autogroup:admin"],
        // Edge routers, one tag per router so each site's routes are bound to
        // exactly one node. The homelab and VCN routers run with SNAT off, so
        // devices behind them keep their own addresses on the tailnet.
        // Homelab edge router; serves ipset:regulad--internal.
        "tag:edge-regulad--internal":                  ["autogroup:admin"],
        // Oracle VCN edge router; serves
        // ipset:pubsub--wahlecloud--oraclevcn--com.
        "tag:edge-pubsub--wahlecloud--oraclevcn--com": ["autogroup:admin"],
        // NC State edge router: a node on NC State's VPN that serves the
        // VPN's routes, ipset:ncstate--net. Unlike the site routers, it DOES
        // SNAT (NC State routes only the VPN's own address back), so no NC
        // State address ever appears on the tailnet. There is no return
        // route: ipset:ncstate--net is never a grant source, and the router
        // itself has no grant of its own. Through it, NC State is only for
        // parkeredwardwahle2017@gmail.com's devices, tagged nodes that reach
        // everything, and the devices behind the site routers; every other
        // node gets DNS to vrd1/vrd2 through it, and NC State's public ranges
        // only over the open internet.
        "tag:edge-ncstate--net":                       ["autogroup:admin"],
    },
    // Each site's subnets, and each machine with several addresses, named
    // after their domain ("--" stands for ".").
    "ipsets": {
        // Homelab subnets.
        "ipset:regulad--internal": [
            "fd83:b84c:aa57:1::/64",
            "10.23.0.0/20",
        ],
        // Oracle VCN subnets.
        "ipset:pubsub--wahlecloud--oraclevcn--com": [
            "2603:c020:4016:ae50::/64",
            "10.131.80.0/24",
        ],
        // NC State's subnets: the split-include routes its VPN pushes, in the
        // VPN's order. IPv4 only, like all of NC State. The two /32s fall
        // inside 152.1.0.0/16, but the VPN lists them separately. 10.0.0.0/8
        // takes in both sites' IPv4 subnets; their routes are longer, so they
        // stay on their own routers.
        "ipset:ncstate--net": [
            "10.0.0.0/8",
            "152.7.0.0/16",
            "152.1.0.0/16",
            "152.14.0.0/16",
            "172.16.0.0/16",
            "172.20.0.0/16",
            "172.23.0.0/16",
            "172.24.0.0/14",
            "172.28.0.0/16",
            "152.1.14.14/32",
            "152.1.14.69/32",
        ],
        // The public ranges behind edge routers, each site's IP set minus its
        // private ranges (which an exit node would forward into its own LAN).
        // Every node reaches them through exit nodes, never through their
        // edge router (see the grant that names them).
        // The VCN's public IPv6 /64.
        "ipset:pubsub--wahlecloud--oraclevcn--com-public": [
            "add ipset:pubsub--wahlecloud--oraclevcn--com",
            "remove 10.0.0.0/8",
        ],
        // NC State's public 152.x ranges.
        "ipset:ncstate--net-public": [
            "add ipset:ncstate--net",
            "remove 10.0.0.0/8",
            "remove 172.16.0.0/12",
        ],
        // The internet, as reached through exit nodes, minus the sites behind
        // edge routers with public ranges: the VCN and NC State. A grant to
        // autogroup:internet alone has no "via", so it would also open every
        // port on those ranges to every node allowed to use exit nodes,
        // through their edge routers. Their public ranges get their own grant
        // instead. The homelab's public IPv6 prefix is DHCPv6-assigned and
        // changes, so it is never listed.
        "ipset:internet": [
            "add autogroup:internet",
            "remove ipset:pubsub--wahlecloud--oraclevcn--com",
            "remove ipset:ncstate--net",
        ],
        // Every node in the tailnet: Tailscale's address ranges.
        "ipset:tail11540--ts--net": [
            "fd7a:115c:a1e0::/48",
            "100.64.0.0/10",
        ],
        // Global DNS resolver (homelab). Every device sends its queries here,
        // since "Override DNS servers" is on (see dns.json5).
        "ipset:pihole--regulad--internal": [
            "fd83:b84c:aa57:1:be24:11ff:fec8:9b09",
            "10.23.2.41",
        ],
        // Split-DNS resolver for regulad.internal (homelab).
        "ipset:arawi--regulad--internal": [
            "fd83:b84c:aa57:1:be24:11ff:fe08:e4e8",
            "10.23.0.254",
        ],
        // Oracle VCN edge router (tag:edge-pubsub--wahlecloud--oraclevcn--com);
        // also the split-DNS resolver for pubsub.wahlecloud.oraclevcn.com.
        "ipset:tailscalerouter--pubsub--wahlecloud--oraclevcn--com": [
            "2603:c020:4016:ae50:0:efc0:c547:1a01",
            "10.131.80.239",
        ],
        // Ingress host (homelab, fixed addresses): the web entry point for
        // every node, and the kodi-plugins publish target.
        "ipset:ingress--regulad--internal": [
            "fd83:b84c:aa57:1:be24:11ff:fe4a:25fa",
            "10.23.2.31",
        ],
        // Jellyfin and Home Assistant host, by its homelab address. The same
        // machine as ipset:aboriginal--tail11540--ts--net, kept separate.
        "ipset:aboriginal--regulad--internal": [
            "fd83:b84c:aa57:1:be24:11ff:fe5d:be75",
            "10.23.2.145",
        ],
        // Jellyfin and Home Assistant host, by its Tailscale address. The
        // same machine as ipset:aboriginal--regulad--internal, kept separate.
        "ipset:aboriginal--tail11540--ts--net": [
            "fd7a:115c:a1e0::9701:a814",
            "100.70.168.20",
        ],
        // TVHeadend host (homelab).
        "ipset:tvheadend--regulad--internal": [
            "fd83:b84c:aa57:1:be24:11ff:fe83:464b",
            "10.23.2.72",
        ],
        // aameter (tag:server), by its Tailscale addresses. Shared out to
        // mark@engagent.dev, who may reach HTTPS on it. Grants for sharees
        // name it by address, not by tag: a grant from shared users to a tag
        // is reported not to match, while one to the node's addresses does
        // (open bug, https://github.com/tailscale/tailscale/issues/14445).
        "ipset:aameter--tail11540--ts--net": [
            "fd7a:115c:a1e0::e738:392f",
            "100.112.57.46",
        ],
    },
    // Single-address machines, named after their domain ("--" stands for
    // ".").
    "hosts": {
        // LEGACY host: IPv4 only. Split-DNS resolver for
        // regulad-verizon-livingston.internal (homelab).
        "cr1000b--regulad-verizon-livingston--internal": "10.23.0.1",
        // LEGACY hosts: IPv4 only, like all of NC State. NC State's
        // split-DNS resolvers for ncsu.edu and ncstate.net, reached through
        // the NC State edge router.
        "vrd1--ddi--ncsu--edu": "152.1.14.14",
        "vrd2--ddi--ncsu--edu": "152.1.14.12",

        // Test-only addresses, used as sources in "tests" (which can't
        // reference IP sets); no machine has them. Each sets as many bits as
        // its subnet allows without being the broadcast address: IPv4 stops
        // one short of it, and IPv6 has no broadcast (and the all-ones
        // interface ID isn't reserved, RFC 5453). The plain name is IPv6;
        // -v4 is the IPv4 counterpart. NC State is IPv4 only, so its plain
        // name is IPv4 and it has no -v4.
        // Homelab.
        "bogus--regulad--internal":                     "fd83:b84c:aa57:1:ffff:ffff:ffff:ffff",
        "bogus--regulad--internal-v4":                  "10.23.15.254",
        // Oracle VCN.
        "bogus--pubsub--wahlecloud--oraclevcn--com":    "2603:c020:4016:ae50:ffff:ffff:ffff:ffff",
        "bogus--pubsub--wahlecloud--oraclevcn--com-v4": "10.131.80.254",
        // Tailnet (Tailscale's fd7a:115c:a1e0::/48 and 100.64.0.0/10): a node
        // with no grant of its own.
        "bogus--tail11540--ts--net":                    "fd7a:115c:a1e0:ffff:ffff:ffff:ffff:ffff",
        "bogus--tail11540--ts--net-v4":                 "100.127.255.254",
        // NC State (IPv4 only), in 172.28.0.0/16, a private range only
        // reachable through its router. As a destination, it checks who may
        // use that router: NC State's public ranges are open to every node
        // through exit nodes, and tests can't tell routers apart ("via"). As
        // a source, it checks there is no return route (its router SNATs).
        "bogus--ncstate--net":                          "172.28.255.254",
    },
    "nodeAttrs": [
        {
            // Every member's devices may use Mullvad exit nodes. Each device
            // takes a slot of the Mullvad add-on (five per license), handed
            // out as devices connect; devices beyond that get no Mullvad.
            // Using them also takes an internet grant (ipset:internet).
            "target": ["autogroup:member"],
            "attr":   ["mullvad"],
        },
        {
            // MagicDNS also answers AAAA (IPv6) queries for tailnet names.
            "target": ["*"],
            "attr":   ["magicdns-aaaa"],
        },
        {
            // tag:funnel nodes and admins' devices may publish services to the
            // internet with Funnel. No other node may, servers included.
            "target": [
                "tag:funnel",
                "autogroup:admin",
            ],
            "attr":   ["funnel"],
        },
    ],
    // Use a random WireGuard listen port instead of the fixed 41641.
    "randomizeClientPort": true,
    "grants": [
        {
            // parkeredwardwahle2017@gmail.com's devices reach everything,
            // NC State through its edge router included. Of user devices,
            // only these may use that router beyond DNS (grants don't decide
            // which routes a device installs, only what the router lets
            // through). Named by user, not autogroup:admin, so a new admin
            // doesn't get it.
            "src": ["parkeredwardwahle2017@gmail.com"],
            "dst": ["*"],
            "ip":  ["*"],
        },
        {
            // Every admin's devices reach everything in the tailnet except NC
            // State through its router, which of all users' devices only
            // parkeredwardwahle2017@gmail.com's reach (above): every node
            // here, and both sites and the internet through the member and
            // every-node grants below.
            "src": ["autogroup:admin"],
            "dst": ["ipset:tail11540--ts--net"],
            "ip":  ["*"],
        },
        {
            // Every member's devices reach every server.
            "src": ["autogroup:member"],
            "dst": ["tag:server"],
            "ip":  ["*"],
        },
        {
            // Exit nodes reach everything.
            "src": ["tag:autoexit"],
            "dst": ["*"],
            "ip":  ["*"],
        },
        {
            // Generic servers reach everything
            "src": ["tag:server"],
            "dst": ["*"],
            "ip":  ["*"],
        },
        {
            // Edge routers, and the devices behind them (SNAT is off, so they
            // arrive with their own addresses), reach everything, including
            // the other site. NC State's router and ipset:ncstate--net are
            // deliberately left out: that router SNATs, and there is no
            // return route from NC State.
            "src": [
                "tag:edge-regulad--internal",
                "tag:edge-pubsub--wahlecloud--oraclevcn--com",
                "ipset:regulad--internal",
                "ipset:pubsub--wahlecloud--oraclevcn--com",
            ],
            "dst": ["*"],
            "ip":  ["*"],
        },
        {
            // Every member reaches the homelab's subnets through its edge
            // router, and only that one: NC State's 10.0.0.0/8 covers
            // 10.23.0.0/20 too, so without "via" this would also open NC
            // State's own 10.23.0.0/20 through the NC State router.
            "src": ["autogroup:member"],
            "dst": ["ipset:regulad--internal"],
            "via": ["tag:edge-regulad--internal"],
            "ip":  ["*"],
        },
        {
            // Every member reaches the VCN's subnets through its edge router,
            // and only that one (NC State's 10.0.0.0/8 covers 10.131.80.0/24
            // too).
            "src": ["autogroup:member"],
            "dst": ["ipset:pubsub--wahlecloud--oraclevcn--com"],
            "via": ["tag:edge-pubsub--wahlecloud--oraclevcn--com"],
            "ip":  ["*"],
        },
        {
            // Members may use the tailnet's own exit nodes (tag:autoexit).
            // Redundant while the grant below lets every node use any exit
            // node; kept so narrowing that grant doesn't cut members off. On
            // its own it likely excludes Mullvad's exit nodes, which aren't
            // tag:autoexit.
            "src": ["autogroup:member"],
            "dst": ["ipset:internet"],
            "via": ["tag:autoexit"],
            "ip":  ["*"],
        },
        {
            // Every node may use any exit node (Mullvad's too, for devices
            // with the mullvad attribute), for the internet minus the VCN and
            // NC State.
            "src": ["*"],
            "dst": ["ipset:internet"],
            "ip":  ["*"],
        },
        {
            // Every node may reach the public ranges behind edge routers (the
            // VCN's /64, NC State's 152.x) over the open internet, through the
            // tailnet's exit nodes, never through their edge routers. "via"
            // takes tags only, so Mullvad's exit nodes can't be named
            // (tailscale/tailscale#15474). A device that installs an edge
            // router's routes sends those ranges to it instead, where this
            // doesn't apply; every node sees the NC State router, for DNS.
            "src": ["*"],
            "dst": [
                "ipset:pubsub--wahlecloud--oraclevcn--com-public",
                "ipset:ncstate--net-public",
            ],
            "via": ["tag:autoexit"],
            "ip":  ["*"],
        },
        {
            // Every node may reach the web entry point.
            "src": ["*"],
            "dst": ["ipset:ingress--regulad--internal"],
            "ip":  [
                "tcp:80",  // HTTP
                "tcp:443", // HTTPS
            ],
        },
        {
            // Every node may query every resolver in dns.json5, so DNS keeps
            // working for nodes with no other grant to them: pihole for
            // everything, arawi for regulad.internal, the VCN edge router for
            // pubsub.wahlecloud.oraclevcn.com, NC State's vrd1 and vrd2
            // (through the NC State edge router) for ncsu.edu and
            // ncstate.net, and the legacy cr1000b for
            // regulad-verizon-livingston.internal.
            "src": ["*"],
            "dst": [
                "ipset:pihole--regulad--internal",
                "ipset:arawi--regulad--internal",
                "ipset:tailscalerouter--pubsub--wahlecloud--oraclevcn--com",
                "vrd1--ddi--ncsu--edu",
                "vrd2--ddi--ncsu--edu",
                "cr1000b--regulad-verizon-livingston--internal",
            ],
            "ip":  [
                "udp:53", // DNS
                "tcp:53", // DNS
            ],
        },
        {
            // kodi-plugins publisher: SSH to the publish target, nothing
            // else (DNS comes from the resolvers grant above).
            "src": ["tag:ci-kodi"],
            "dst": ["ipset:ingress--regulad--internal"],
            "ip":  [
                "tcp:22", // SSH (scp)
            ],
        },
        {
            // IoT devices: Jellyfin and Home Assistant, by either of the
            // host's names.
            "src": ["tag:iot"],
            "dst": [
                "ipset:aboriginal--regulad--internal",
                "ipset:aboriginal--tail11540--ts--net",
            ],
            // No udp:7359 (Jellyfin client discovery): it is broadcast-based,
            // and the tailnet carries no broadcast or multicast traffic.
            "ip":  [
                "tcp:8096", // Jellyfin HTTP
                "tcp:8920", // Jellyfin HTTPS
                "tcp:8123", // Home Assistant HTTP
            ],
        },
        {
            // IoT devices: TVHeadend.
            "src": ["tag:iot"],
            "dst": ["ipset:tvheadend--regulad--internal"],
            "ip":  [
                "tcp:9981", // TVHeadend HTTP
                "tcp:9982", // TVHeadend HTSP
            ],
        },
        {
            // mark@engagent.dev, who aameter is shared with: HTTPS on aameter
            // and nothing else. A sharee is also a "*" source, but the
            // every-node grants point at subnets and exit nodes, which
            // sharing doesn't carry, so this is all they can reach.
            "src": ["mark@engagent.dev"],
            "dst": ["ipset:aameter--tail11540--ts--net"],
            "ip":  [
                "tcp:443", // HTTPS
            ],
        },
        {
            // Every node may use the peer relays to help establish
            // connections. This grants relay use only, not network access to
            // the relay nodes.
            "src": ["*"],
            "dst": ["tag:relay"],
            "app": {"tailscale.com/cap/relay": []},
        },
    ],
    "autoApprovers": {
        // Exit-node advertisements from tag:autoexit are approved
        // automatically.
        "exitNode": ["tag:autoexit"],

        "routes": {
            // Each site's subnets are auto-approved for its own edge router.
            // Route keys must be literal CIDRs (IP sets aren't accepted
            // here), so keep these in sync with the site's IP set.
            "fd83:b84c:aa57:1::/64":    ["tag:edge-regulad--internal"],
            "10.23.0.0/20":             ["tag:edge-regulad--internal"],
            "2603:c020:4016:ae50::/64": ["tag:edge-pubsub--wahlecloud--oraclevcn--com"],
            "10.131.80.0/24":           ["tag:edge-pubsub--wahlecloud--oraclevcn--com"],
            "10.0.0.0/8":               ["tag:edge-ncstate--net"],
            "152.7.0.0/16":             ["tag:edge-ncstate--net"],
            "152.1.0.0/16":             ["tag:edge-ncstate--net"],
            "152.14.0.0/16":            ["tag:edge-ncstate--net"],
            "172.16.0.0/16":            ["tag:edge-ncstate--net"],
            "172.20.0.0/16":            ["tag:edge-ncstate--net"],
            "172.23.0.0/16":            ["tag:edge-ncstate--net"],
            "172.24.0.0/14":            ["tag:edge-ncstate--net"],
            "172.28.0.0/16":            ["tag:edge-ncstate--net"],
            "152.1.14.14/32":           ["tag:edge-ncstate--net"],
            "152.1.14.69/32":           ["tag:edge-ncstate--net"],

            // Any subnet route advertised by tag:autorouter is approved
            // automatically (every prefix falls inside these two), the site
            // subnets above included.
            "::/0":      ["tag:autorouter"],
            "0.0.0.0/0": ["tag:autorouter"],
        },
    },
    // Regression tests: Tailscale runs them on every apply and rejects the
    // policy if one fails. Each principal asserts what it must reach and,
    // where it is restricted, what it must not. Tests can't reference IP
    // sets, so destinations are literal addresses (IPv6 first, bracketed);
    // when a machine's address changes, update it here too. Deny lists probe
    // SSH (22), NetBIOS (139), SMB (445), AFP (548) and lockdownd (62078).
    // Without "proto", a test checks TCP and UDP.
    //
    // A tag source only matches the every-node ("*") grants over IPv4 in
    // tests (the test runner matches "*" by address and seems to give a tag
    // only an IPv4 one), though real tagged devices match over both. So tag
    // tests check those grants over IPv4, and the bogus tailnet host checks
    // them over IPv6 and IPv4.
    "tests": [
        {
            // A tailnet node with no grant of its own gets only what every
            // node gets: DNS, the web entry point, and the internet. The VCN's
            // and NC State's public ranges it reaches through exit nodes only,
            // which tests can't tell from their routers ("via"), so the IPv4
            // test checks the sites' private ranges instead. NC State is IPv4
            // only, so the IPv4 test also covers its resolvers.
            "src": "bogus--tail11540--ts--net",
            "accept": [
                "[2606:4700:4700::1111]:443",                  // internet (Cloudflare)
                "[fd83:b84c:aa57:1:be24:11ff:fec8:9b09]:53",   // pihole
                "[fd83:b84c:aa57:1:be24:11ff:fe08:e4e8]:53",   // arawi
                "[2603:c020:4016:ae50:0:efc0:c547:1a01]:53",   // VCN edge router
                "[fd83:b84c:aa57:1:be24:11ff:fe4a:25fa]:443",  // ingress, HTTPS
                "[fd83:b84c:aa57:1:be24:11ff:fe4a:25fa]:80",   // ingress, HTTP
            ],
            "deny": [
                "[fd83:b84c:aa57:1:be24:11ff:fe4a:25fa]:22",   // ingress, SSH
                "[fd83:b84c:aa57:1:be24:11ff:fe4a:25fa]:445",  // ingress, SMB
                "[fd83:b84c:aa57:1:be24:11ff:fec8:9b09]:80",   // pihole, web UI
                "[fd83:b84c:aa57:1:be24:11ff:fe5d:be75]:8096", // aboriginal, Jellyfin
                "[fd7a:115c:a1e0::9701:a814]:62078",           // aboriginal (tailnet), lockdownd
                "[fd83:b84c:aa57:1:be24:11ff:fe83:464b]:9981", // tvheadend
                "tag:server:22",
                "tag:iot:62078",
                "bogus--regulad--internal:445",
            ],
        },
        {
            "src": "bogus--tail11540--ts--net-v4",
            "accept": [
                "1.1.1.1:443",                                 // internet (Cloudflare)
                "10.23.2.41:53",                               // pihole
                "10.23.0.254:53",                              // arawi
                "10.131.80.239:53",                            // VCN edge router
                "vrd1--ddi--ncsu--edu:53",
                "vrd2--ddi--ncsu--edu:53",
                "cr1000b--regulad-verizon-livingston--internal:53",
                "10.23.2.31:443",                              // ingress, HTTPS
            ],
            "deny": [
                "10.23.2.31:22",                               // ingress, SSH
                "10.23.2.41:139",                              // pihole, NetBIOS
                "10.23.2.145:8096",                            // aboriginal, Jellyfin
                "100.70.168.20:548",                           // aboriginal (tailnet), AFP
                "10.23.2.72:9982",                             // tvheadend
                "tag:server:22",
                "tag:iot:62078",
                "bogus--regulad--internal-v4:445",
                "bogus--pubsub--wahlecloud--oraclevcn--com-v4:548",
                "bogus--ncstate--net:445",
            ],
        },
        {
            // DNS to NC State's resolvers, over UDP and TCP explicitly, from a
            // node with no grant of its own. Their other ports are open to it
            // over the open internet (exit nodes) but not through the NC State
            // router, which tests can't tell apart, so they aren't probed.
            "src": "bogus--tail11540--ts--net-v4",
            "proto": "udp",
            "accept": [
                "vrd1--ddi--ncsu--edu:53",
                "vrd2--ddi--ncsu--edu:53",
            ],
        },
        {
            "src": "bogus--tail11540--ts--net-v4",
            "proto": "tcp",
            "accept": [
                "vrd1--ddi--ncsu--edu:53",
                "vrd2--ddi--ncsu--edu:53",
            ],
